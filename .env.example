# Vault AI - Environment Configuration
# Copy this file to .env and update values for your environment

# =============================================================================
# VAULT CONNECTION (Required)
# =============================================================================

# Vault server URL
VAULT_ADDR=https://vault.example.com:8200

# TLS for the MCP proxy -> Vault connection.
# If Vault uses a private or self-signed CA (e.g. `vault server -dev-tls`),
# point VAULT_CACERT at the CA that signed Vault's listener certificate so the
# proxy can verify it without modifying the host trust store.
# VAULT_CACERT=/certs/vault-ca.pem
#
# Alternatively, a directory containing one or more PEM CA files:
# VAULT_CAPATH=/certs/ca

# Skip TLS certificate verification (development only - NOT for production).
# Takes effect only when VAULT_ADDR is https://. Prefer VAULT_CACERT instead.
VAULT_SKIP_VERIFY=false

# Optional mutual-TLS client certificate for authenticating to Vault's listener.
# VAULT_CLIENT_CERT=/certs/client.pem
# VAULT_CLIENT_KEY=/certs/client-key.pem

# Override the certificate hostname / SNI used during the TLS handshake.
# VAULT_TLS_SERVER_NAME=vault.internal

# Vault namespace (Enterprise only)
# VAULT_NAMESPACE=admin

# =============================================================================
# MCP PROXY CONFIGURATION
# =============================================================================

# MCP proxy internal port
MCP_PROXY_PORT=3001

# Logging level: debug, info, warn, error
MCP_LOG_LEVEL=info

# =============================================================================
# WEB UI CONFIGURATION
# =============================================================================

# Browser tab title
VITE_APP_TITLE=Vault AI

# Vault address for browser (may differ from server-side if using proxy)
VITE_VAULT_ADDR=https://vault.example.com:8200

# =============================================================================
# SESSION MANAGEMENT
# =============================================================================

# Session idle timeout in seconds (default: 1 hour)
SESSION_TIMEOUT=3600

# =============================================================================
# TLS CONFIGURATION (Optional - for container-level TLS termination)
# =============================================================================

# Path to TLS certificate
# TLS_CERT_PATH=/certs/server.crt

# Path to TLS private key
# TLS_KEY_PATH=/certs/server.key
